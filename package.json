{
  "name": "jev-dev-harness",
  "version": "0.1.5",
  "description": "Developer Harness with TypeSafe AI / Jev for AI Coding Agents",
  "type": "module",
  "bin": {
    "jev-dev-harness": "bin/jev-mcp.js",
    "jev-dev": "bin/jev-dev.js",
    "jev-mcp": "bin/jev-mcp.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./context-ranker": {
      "types": "./dist/context-ranker/index.d.ts",
      "import": "./dist/context-ranker/index.js"
    },
    "./patch-reviewer": {
      "types": "./dist/patch-reviewer/index.d.ts",
      "import": "./dist/patch-reviewer/index.js"
    },
    "./tool-guard": {
      "types": "./dist/tool-guard/index.d.ts",
      "import": "./dist/tool-guard/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js"
    },
    "./semantic-linter": {
      "types": "./dist/semantic-linter/index.d.ts",
      "import": "./dist/semantic-linter/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "dashboard",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build && vitest run",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest run tests/benchmark/",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "typesafe",
    "jev",
    "developer-harness",
    "context-ranker",
    "coding-agents",
    "mcp",
    "modelcontextprotocol",
    "codex",
    "antigravity"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/celolopes/jev-dev-harness.git"
  },
  "bugs": {
    "url": "https://github.com/celolopes/jev-dev-harness/issues"
  },
  "homepage": "https://github.com/celolopes/jev-dev-harness#readme",
  "author": "celolopes",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "commander": "^13.1.0",
    "ignore": "^7.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
